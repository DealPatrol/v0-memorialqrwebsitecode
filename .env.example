# Google Search Console HTML-tag verification.
# Paste only the content value from the meta tag, not the full tag.
# The site emits metadata.verification.google only when this variable is a
# non-empty string at build time. Leave it blank to omit the tag.
# Search Console HTML-tag token (either name works)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
GOOGLE_SITE_VERIFICATION=

# QR Memorial Plaque checkout. Square charges the card. These are the same
# variables the concierge checkout uses. SQUARE_ENVIRONMENT must be production
# on memorialsqr.com.
# NEXT_PUBLIC_SQUARE_APPLICATION_ID=
# NEXT_PUBLIC_SQUARE_LOCATION_ID=
# SQUARE_ACCESS_TOKEN=
# SQUARE_LOCATION_ID=
# SQUARE_ENVIRONMENT=production

# Make-and-ship email for the QR Memorial Plaque. The notice always goes to
# support@memorialsqr.com. ADMIN_EMAIL is added when it is a different inbox.
# RESEND_FROM_EMAIL is optional.
# RESEND_API_KEY=
# ADMIN_EMAIL=
# RESEND_FROM_EMAIL=

# Optional ad pixels. Each tag loads only when its id is set and valid.
# These are public, build-time values. Set them, then redeploy.
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_GA4_ID=
# NEXT_PUBLIC_GOOGLE_ADS_ID=
# NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
# NEXT_PUBLIC_PINTEREST_TAG_ID=

# Partner API that creates a placeholder memorial for an already-printed QR.
# Send the secret as `x-partner-secret` or `Authorization: Bearer <secret>`.
# PARTNER_API_SECRET=

# Square sandbox for a test checkout. Do not put live production tokens here.
# NEXT_PUBLIC_SQUARE_APPLICATION_ID=
# NEXT_PUBLIC_SQUARE_LOCATION_ID=
# SQUARE_ACCESS_TOKEN=
# SQUARE_LOCATION_ID=
# SQUARE_ENVIRONMENT=sandbox

# Printify. Shared shop credentials, then one provider id and variant id per
# catalog product. The env key is the product id in uppercase with other
# characters replaced by underscores. Example for human-photo-canvas:
# PRINTIFY_API_TOKEN=
# PRINTIFY_SHOP_ID=
# PRINTIFY_HUMAN_PHOTO_CANVAS_BLUEPRINT_ID=1159
# PRINTIFY_HUMAN_PHOTO_CANVAS_PROVIDER_ID=
# PRINTIFY_HUMAN_PHOTO_CANVAS_VARIANT_ID=
# Pet products from the retired Tailkept store have no blueprint id in the
# catalog until the matching PRINTIFY_<ID>_BLUEPRINT_ID is set. Without a
# token, shop, provider, or variant, paid orders save a mock payload and are
# not submitted.
# Merchize products are never submitted to Printify. The admin email is flagged.

# Supabase redirect allow-list must include
# https://memorialsqr.com/auth/callback
# so claim magic links can return to /claim/{code}.
# Apply scripts/030_partner_memorial_codes.sql before taking memorial orders.
